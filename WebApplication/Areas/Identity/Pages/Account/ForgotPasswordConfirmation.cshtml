@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Confirmación de reinicio de contraseña";
}

<h1>@ViewData["Title"]</h1>
<p>
    Por favor revise su correo electrónico para obtener un enlace de restablecimiento de contraseña.
</p>
<p>
    Si no recibe un correo electrónico, revise su carpeta de spam o vuelva a intentarlo.
</p>
