@page
@model WebApplication.Pages.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Editar</h1>

<h4>Estudiante</h4>
<form method="post" enctype="multipart/form-data">
    <div class="form-group row row-cols-3 align-items-center">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Student.Id" />
        <div class="col">
            <label asp-for="Student.Name" class="form-label"></label>
            <input asp-for="Student.Name" class="form-control" />
            <span asp-validation-for="Student.Name" class="text-danger"></span>
        </div>
        <div class="col">
            <label asp-for="Student.FamilyName" class="form-label"></label>
            <input asp-for="Student.FamilyName" class="form-control" />
            <span asp-validation-for="Student.FamilyName" class="text-danger"></span>
        </div>
        <div class="col">
            <label asp-for="Student.CURP" class="form-label"></label>
            <input asp-for="Student.CURP" class="form-control" />
            <span asp-validation-for="Student.CURP" class="text-danger"></span>
        </div>
        <div class="col">
            <label asp-for="Student.Semester" class="form-label"></label>
            <select asp-for="Student.Semester" class="form-control">
                <option value="" disabled selected>--Selecionar Semestre--</option>
                <option value="1">1er Semestre</option>
                <option value="3">3er Semestre</option>
                <option value="5">5to Semestre</option>
            </select>
            <span asp-validation-for="Student.Semester" class="text-danger"></span>
        </div>
        <div class="col">
            <label asp-for="Student.NSS" class="form-label"></label>
            <input asp-for="Student.NSS" class="form-control" />
            <span asp-validation-for="Student.NSS" class="text-danger"></span>
        </div>
        <div class="col">
            <label asp-for="Student.BloodType" class="form-label"></label>
            <input asp-for="Student.BloodType" class="form-control" />
            <span asp-validation-for="Student.BloodType" class="text-danger"></span>
        </div>
        <div class="col">
            <label asp-for="Student.TutorName" class="form-label"></label>
            <input asp-for="Student.TutorName" class="form-control" />
            <span asp-validation-for="Student.TutorName" class="text-danger"></span>
        </div>
        <div class="col">
            <label asp-for="Student.TutorPhone" class="form-label"></label>
            <input asp-for="Student.TutorPhone" class="form-control" />
            <span asp-validation-for="Student.TutorPhone" class="text-danger"></span>
        </div>
    </div>
    <div class="row mx-auto mt-3 w-25 h-25">
        <img src="@(string.IsNullOrEmpty(Model.Student.ProfilePictureUrl) ? "/photos/placeholder.png" : Model.Student.ProfilePictureUrl)" id="photo_preview" class="img-thumbnail mb-2" />
        <input type="file" name="UploadedPhoto" id="photo_uploader" accept=".png, .jpg" />
        <button id="submit_button" class="btn btn-primary mt-3" type="submit">Guardar Cambios</button>
    </div>
</form>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    <script src="~/js/ImageUploading.js"></script>
}