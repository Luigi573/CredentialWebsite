@page
@model WebApplication.Pages.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Student</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Student.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Student.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Student.FamilyName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Student.FamilyName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Student.CURP)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Student.CURP)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Student.SchoolYear)
        </dt>
        <dd class="col-sm-10">
            @(Model.Student.SchoolYear?.Name ?? string.Empty)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Student.Semester)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Student.Semester)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Student.IsActive)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Student.IsActive)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Student.NSS)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Student.NSS)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Student.BloodType)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Student.BloodType)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Student.TutorName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Student.TutorName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Student.TutorPhone)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Student.TutorPhone)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Student.ProfilePictureUrl)
        </dt>
        <dd class="col-sm-10">
            <img src="@(string.IsNullOrEmpty(Model.Student.ProfilePictureUrl)? "/photos/placeholder.png" : Model.Student.ProfilePictureUrl)" alt="Profile Picture" class="figure-img" width="100" height="100" />
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Student.Id">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
