@page
@model WebApplication.Data.Student

<h1>Formato de registro</h1>
<form method="post" enctype="multipart/form-data">
    <div class="form-group row row-cols-3 align-items-center">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="col">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col">
            <label asp-for="FamilyName" class="form-label"></label>
            <input asp-for="FamilyName" class="form-control" />
            <span asp-validation-for="FamilyName" class="text-danger"></span>
        </div>
        <div class="col">
            <label asp-for="CURP" class="form-label"></label>
            <input asp-for="CURP" class="form-control" />
            <span asp-validation-for="CURP" class="text-danger"></span>
        </div>
        <div class="col">
            <label asp-for="SchoolPeriod" class="form-label"></label>
            <input asp-for="SchoolPeriod" class="form-control" />
            <span asp-validation-for="SchoolPeriod" class="text-danger"></span>
        </div>
        <div class="col">
            <label asp-for="Semester" class="form-label"></label>
            <select asp-for="Semester" class="form-control">
                <option value="" disabled selected>--Selecionar Semestre--</option>
                <option value="1">1er Semestre</option>
                <option value="2">2do Semestre</option>
                <option value="3">3er Semestre</option>
                <option value="4">4to Semestre</option>
                <option value="5">5to Semestre</option>
                <option value="6">6to Semestre</option>
            </select>
            <span asp-validation-for="Semester" class="text-danger"></span>
        </div>
        <div class="col">
            <label asp-for="NSS" class="form-label"></label>
            <input asp-for="NSS" class="form-control" />
            <span asp-validation-for="NSS" class="text-danger"></span>
        </div>
        <div class="col">
            <label asp-for="BloodType" class="form-label"></label>
            <input asp-for="BloodType" class="form-control" />
            <span asp-validation-for="BloodType" class="text-danger"></span>
        </div>
        <div class="col">
            <label asp-for="TutorName" class="form-label"></label>
            <input asp-for="TutorName" class="form-control" />
            <span asp-validation-for="TutorName" class="text-danger"></span>
        </div>
        <div class="col">
            <label asp-for="TutorPhone" class="form-label"></label>
            <input asp-for="TutorPhone" class="form-control" />
            <span asp-validation-for="TutorPhone" class="text-danger"></span>
        </div>
    </div>
    <div class="row mx-auto mt-3 w-25 h-25">
        <img src="https://upload.wikimedia.org/wikipedia/commons/8/89/Portrait_Placeholder.png" id="photo_preview" class="img-thumbnail mb-2" />
        <input type="file" name="studentPhoto" id="photo_uploader" accept=".png, .jpg" />
        <button id="submit_button" class="btn btn-primary mt-3" type="submit">Submit</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/ImageUploading.js"></script>
}
