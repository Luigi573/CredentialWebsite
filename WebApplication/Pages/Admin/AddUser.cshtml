@page
@model WebApplication.Pages.Admin.AddUserModel
@{
}

<h1>Agregar Usuario</h1>

<form method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label asp-for="Teacher.Name"></label>
        <input asp-for="Teacher.Name" class="form-control" />
        <span asp-validation-for="Teacher.Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Teacher.Email"></label>
        <input asp-for="Teacher.Email" class="form-control" />
        <span asp-validation-for="Teacher.Email" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Teacher.SchoolId"></label>
        <select asp-for="Teacher.SchoolId" class="form-control" asp-items="Model.Schools">
            <option value="">--Seleccionar Centro--</option>
        </select>
        <span asp-validation-for="Teacher.SchoolId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="SelectedRole">Rol</label>
        <select asp-for="SelectedRole" class="form-control">
            <option value="Teacher" selected>Docente</option>
            <option value="Admin">Administrador</option>
        </select>
    </div>
    <div class="row mx-auto mt-3 w-25 h-25">
        <button id="submit_button" class="btn btn-primary mt-3" type="submit">Crear</button>
    </div>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
</form> 

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/ImageUploading.js"></script>
}