@page
@model WebApplication.Pages.Admin.UserInfoModel
@{
}

<h1>Información del Usuario</h1>

<div>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Teacher.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Teacher.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Teacher.Email)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Teacher.Email)
        </dd>
        <dt class="col-sm-2">
            Nombre Centro
        </dt>
        <dd class="col-sm-10">
            @(Model.Teacher.School?.Name ?? string.Empty)
        </dd>
        <dt class="col-sm-2">
            Clave Centro
        </dt>
        <dd class="col-sm-10">
            @(Model.Teacher.School?.Code ?? string.Empty)
        </dd>
    </dl>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}