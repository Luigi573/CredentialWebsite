@page
@model WebApplication.Pages.Admin.ManageUsersModel
@{
}

<h1>Gestión de Usuarios</h1>

<p>
    <a asp-page="AddUser">Agregar Usuario</a>
</p>
<form asp-page-handler="AdvanceYear" method="post" class="mb-3 d-flex align-items-center justify-content-between">
    <p class="mb-0"><strong>Ciclo Escolar: </strong>@Model.CurrentSchoolYear.Name</p>
    @if (Model.CurrentSchoolYear.EndDate <= DateTime.Now)
    {
        <button type="submit" class="btn btn-primary">Avanzar ciclo</button>
    }
    else
    {
        <span class="text-muted">No se puede avanzar el ciclo actualmente</span>
    }
</form>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Teachers[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Teachers[0].Email)
            </th>
            <th>
                Nombre Centro
            </th>
            <th>
                Clave Centro
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Teachers)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Email)
                </td>
                <td>
                    @(item.School?.Name ?? string.Empty)
                </td>
                <td>
                    @(item.School?.Code ?? string.Empty)
                </td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-page="./UserInfo" asp-route-id="@item.Id">Details</a> |
                    <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" class="d-inline-block" onsubmit="return deleteUser();">
                        <button type="submit" class="btn btn-link p-0">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>