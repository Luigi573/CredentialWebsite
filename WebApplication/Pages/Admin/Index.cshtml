@page
@model WebApplication.Pages.Admin.ManageUsersModel
@{
}

<h1>Gestión de Usuarios</h1>

<p>
    <a asp-page="AddUser">Agregar Usuario</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Teachers[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Teachers[0].Email)
            </th>
            <th>
                Nombre Centro
            </th>
            <th>
                Clave Centro
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Teachers)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Email)
                </td>
                <td>
                    @(item.School?.Name ?? string.Empty)
                </td>
                <td>
                    @(item.School?.Code ?? string.Empty)
                </td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-page="./UserInfo" asp-route-id="@item.Id">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
