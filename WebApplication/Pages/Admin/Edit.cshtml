@page
@model WebApplication.Pages.Admin.EditModel
@{
}

<h1>Modificar Usuario</h1>

<form method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Teacher.Id" />
    <div class="form-group">
        <label asp-for="Teacher.Name"></label>
        <input asp-for="Teacher.Name" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Teacher.Email"></label>
        <input asp-for="Teacher.Email" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Teacher.SchoolId"></label>
        <select asp-for="Teacher.SchoolId" class="form-control" asp-items="Model.Schools">
            <option value="">--Seleccionar Centro--</option>
        </select>
        <span asp-validation-for="Teacher.SchoolId" class="text-danger"></span>
    </div>
    <button id="submit_button" class="btn btn-primary mt-3" type="submit">Guardar</button>
</form>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}
