@page
@model WebApplication.Pages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="StudentForm">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Student[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Student[0].FamilyName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Student[0].CURP)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Student[0].SchoolPeriod)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Student[0].Semester)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Student[0].NSS)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Student[0].BloodType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Student[0].ProfilePictureUrl)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Student) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FamilyName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CURP)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SchoolPeriod)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Semester)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NSS)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BloodType)
            </td>
            <td>
                    <img src="@item.ProfilePictureUrl" alt="Profile Picture" width="100" height="100" />
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
