@page
@model WebApplication.Pages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Registro de estudiantes</h1>

<p>
    <a asp-page="StudentForm">Añadir estudiante</a>
</p>

<div class="row">
    <form id="search_form" method="post" class="row g-2 align-items-end" asp-page-handler="Search">
        <div class="col-4">
            @if (User.IsInRole("Admin"))
            {
                <div class="row">
                    <div class="col-8">
                        <select id="school_select" class="form-control" asp-for="@Model.SelectedSchoolId" asp-items="Model.Schools">
                            <option value="">--Seleccionar Centro--</option>
                        </select>
                    </div>
                </div>
            }
        </div>
        <div class="col-8">
            <div class="row">
                <div class="col-4">
                    <select id="semester_select" class="form-control">
                        <option value="">--Seleccionar Semestre--</option>
                        <option value="1">1er Semestre</option>
                        <option value="3">3er Semestre</option>
                        <option value="5">5to Semestre</option>
                    </select>
                </div>

                <div class="col-8">
                    <input id="search_input" type="text" class="form-control" placeholder="Nombre del estudiante" />
                </div>
            </div>
        </div>
    </form>
</div>

<form method="post" asp-page-handler="Deactivate">
    <table id="students_table" class="table text-center">
        <thead>
            <tr>
                <th></th>
                <th>
                    @Html.DisplayNameFor(model => model.Students[0].Name)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Students[0].FamilyName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Students[0].CURP)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Students[0].Semester)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Students[0].NSS)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Students[0].ProfilePictureUrl)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Students)
            {
                <tr>
                    <td>
                        <input type="checkbox" name="SelectedStudents" value="@item.Id" class="student-checkbox" />
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Name)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.FamilyName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CURP)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Semester)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.NSS)
                    </td>
                    <td>
                        <img src="@item.ProfilePictureUrl" alt="Profile Picture" width="100" height="100" />
                    </td>
                    <td>
                        <a asp-page="./Edit" asp-route-id="@item.Id">Editar</a> |
                        <a asp-page="./Details" asp-route-id="@item.Id">Detalles</a> |
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div class="row mx-auto mt-3 w-25 h-25">
        <button id="delete_students" class="btn btn-primary mt-3" type="submit" disabled>Dar de baja</button>
    </div>
</form>

@section Scripts{
    <script src="~/js/StudentIndex.js"></script>
}